# Copiá este archivo a .env.local y completá los valores.
# .env.local nunca se versiona (ver .gitignore) — ahí van los secretos.
# También podés configurar la key desde la UI, en /ajustes.

# Key de OpenRouter (https://openrouter.ai/keys) — necesaria para generar
# tarjetas/definiciones con IA. Reiniciá `npm run dev` después de setearla.
OPENROUTER_API_KEY=

# Modelo de texto a usar en OpenRouter. Default si se omite: ver lib/openrouter.ts.
OPENROUTER_MODEL=

# Modelo de imágenes a usar en OpenRouter. Default si se omite: ver lib/openrouter-images.ts.
OPENROUTER_IMAGE_MODEL=

# URL de AnkiConnect, si usás Anki para exportar tarjetas. Default: http://localhost:8765
ANKI_CONNECT_URL=

# Ruta al diccionario de Kuromoji (tokenizer japonés), si no usás la default del paquete.
KUROMOJI_DIC_PATH=

# Ruta al archivo SQLite de la app. Default: data/app.db (se crea solo).
APP_DB_PATH=
